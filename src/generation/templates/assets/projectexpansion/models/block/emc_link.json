{
	"$for": {
		"tier": "MATTER",
		"filter": [true, false]
	},
	"$let": { "suffix": "filter ? '' : '_nofilter'" },
	"$output": "emc_link/{{tier}}{{suffix}}",
	"$content": {
		"parent": "projectexpansion:block/emc_link/layers",
		"textures": {
			"particle": "{{id(`block/emc_link/base${suffix}`)}}",
			"base": "{{id(`block/emc_link/base${suffix}`)}}",
			"star": "{{id(`block/emc_link/star/${tier}`)}}"
		}
	}
}
