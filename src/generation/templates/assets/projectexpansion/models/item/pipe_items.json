{
	"$if": "since('1.18')",
	"$for": { "item": "['wrench', ...['basic', 'improved', 'advanced', 'ultimate', 'infinity'].map(tier => `${tier}_pipe_upgrade`)]" },
	"$output": "{{item}}",
	"$content": {
		"parent": "minecraft:item/generated",
		"textures": {
			"layer0": "{{id(item === 'wrench' ? 'item/wrench' : `item/pipe_upgrade/${item.replace('_pipe_upgrade', '')}`)}}"
		}
	}
}
