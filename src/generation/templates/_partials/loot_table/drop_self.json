{
	"type": "minecraft:block",
	"pools": [
		{
			"rolls": 1,
			"entries": [
				{ "type": "minecraft:item", "name": "{{id(block)}}" }
			],
			"conditions": [
				{ "condition": "minecraft:survives_explosion" }
			]
		}
	],
	"random_sequence": { "$if": "since('1.20')", "$then": "{{id('blocks/' + block)}}" }
}
