{
	"$for": {
		"block": "['ianthium_ore', ...(since('1.18') ? ['deepslate_ianthium_ore'] : [])]"
	},
	"$output": "{{block}}",
	"$content": {
		"type": "minecraft:block",
		"pools": [
			{
				"rolls": 1,
				"bonus_rolls": 0,
				"entries": [
					{
						"type": "minecraft:alternatives",
						"children": [
							{
								"type": "minecraft:item",
								"name": "{{id(block)}}",
								"conditions": [
									{
										"condition": "minecraft:match_tool",
										"predicate": {
											"$if": "since('1.20.5')",
											"$then": {
												"predicates": {
													"minecraft:enchantments": [
														{
															"enchantments": "minecraft:silk_touch",
															"levels": {
																"min": 1
															}
														}
													]
												}
											},
											"$else": {
												"enchantments": [
													{
														"enchantment": "minecraft:silk_touch",
														"levels": {
															"min": 1
														}
													}
												]
											}
										}
									}
								]
							},
							{
								"type": "minecraft:item",
								"name": "projectexpansion:raw_ianthium",
								"functions": [
									{
										"function": "minecraft:apply_bonus",
										"enchantment": "minecraft:fortune",
										"formula": "minecraft:ore_drops"
									},
									{
										"function": "minecraft:explosion_decay"
									}
								]
							}
						]
					}
				]
			}
		],
		"random_sequence": {
			"$if": "since('1.20')",
			"$then": "{{id(`blocks/${block}`)}}"
		}
	}
}
