{
	"$if": "since('1.18')",
	"$for": { "tier": "['improved', 'advanced', 'ultimate', 'infinity']" },
	"$let": {
		"matter": "({ improved: 'projecte:red_matter', advanced: 'projectexpansion:magenta_matter', ultimate: 'projectexpansion:blue_matter', infinity: 'projectexpansion:final_star_shard' })[tier]",
		"previous": "`projectexpansion:${['basic', 'improved', 'advanced', 'ultimate'][tierIndex]}_emc_storage`"
	},
	"$output": "emc_storage/{{tier}}",
	"$content": {
		"type": "projectexpansion:emc_storage_upgrade",
		"category": "misc",
		"pattern": ["AMA", "MSM", "AMA"],
		"key": {
			"A": "{{ingredient('#c:ingots/ianthium')}}",
			"M": "{{ingredient(matter)}}",
			"S": "{{ingredient(previous)}}"
		},
		"result": "{{result(`projectexpansion:${tier}_emc_storage`, 1)}}"
	}
}
