	"$for": { "name": ["dragon_immune", "wither_immune"] },
	"$output": "{{name}}",
	"$content": {
		"replace": false,
		"values": [
			{ "$each": "MATTER_BLOCKS", "$do": "{{id(`${it}_matter_block`)}}" },
